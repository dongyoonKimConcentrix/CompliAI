# ===========================================
# CompliAI — 환경 변수 템플릿
# 이 파일을 복사해 .env 를 만들고 실제 값을 채워주세요.
# cp .env.example .env
# ===========================================

# --- Next.js / NextAuth ---
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# --- Database (Prisma) ---
# 로컬: localhost | Docker Compose: db (호스트명)
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/compliai_db

# Docker Compose 전용 (선택 — 미설정 시 myuser/mypassword/compliai_db 기본값)
# POSTGRES_USER=myuser
# POSTGRES_PASSWORD=mypassword
# POSTGRES_DB=compliai_db

# --- FastAPI AI Backend ---
# 로컬: http://localhost:8000 | Docker Compose: http://api:8000
FASTAPI_INTERNAL_URL=http://localhost:8000

# --- OpenAI (FastAPI 서버 실행 시 사용) ---
OPENAI_API_KEY=sk-proj-your-actual-key-here

# --- SMTP 이메일 인증 ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# --- 월간 칭찬왕 메일 Cron (GitHub Actions / 외부 스케줄러) ---
CRON_SECRET=your_random_cron_secret_here
